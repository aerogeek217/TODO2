/*
 * Vitest files (`src/test/**`): the app's options plus Node's types (the
 * tests read files and set `process.env`). Referenced from tsconfig.json, so
 * `tsc -b` / `npm run build` type-check the tests too; ESLint parses them
 * with it (eslint.config.js).
 */
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/test", "src/types"],
  "exclude": []
}
